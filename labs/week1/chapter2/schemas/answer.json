{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG grounded answer (SPEC C-04 / C-05, §19)",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "confidence", "sources"],
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "description": "The free-form answer grounded in the retrieved context."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "The model's self-reported confidence in [0,1]."
    },
    "sources": {
      "type": "array",
      "items": {"type": "string"},
      "description": "doc_ids the model claims to cite; the harness enforces these are a subset of the retrieved context (I-003)."
    }
  }
}
