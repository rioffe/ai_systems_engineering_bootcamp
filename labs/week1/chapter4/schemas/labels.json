{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {"$ref": "#/$defs/label"},
  "$defs": {
    "label": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "correct": {"type": "boolean"},
        "supported": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
